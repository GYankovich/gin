# Production (nefor.online) — copy to .env.production
# Start backend with:  set GIN_ENV=production   (PowerShell: $env:GIN_ENV="production")
# Do not commit secrets.

DB_HOST=your.db.host
DB_PORT=5432
DB_NAME=gin
DB_USER=postgres
DB_PASSWORD=change_me
DB_SCHEMA=public
DB_SSL_MODE=require

SECRET_KEY=change_me_to_a_long_random_string_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

DEBUG=false
ENVIRONMENT=production

CORS_ORIGINS=["https://nefor.online","https://www.nefor.online","https://nefor.online:8443","https://www.nefor.online:8443"]

WS_PORT=8001
LIVE_EVENTS_BACKEND=postgres
WORKER_EMBEDDED_ENABLED=false
