# Local development (optional: remote PostgreSQL)
# Copy to .env — do not commit secrets.

DB_HOST=your.remote.db.host
DB_PORT=5432
DB_NAME=gin
DB_USER=postgres
DB_PASSWORD=change_me
DB_SCHEMA=public
DB_SSL_MODE=require

SECRET_KEY=change_me_to_a_long_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

DEBUG=true
ENVIRONMENT=development

# Greenfield robots v2 (/api/v2/robots/*, UI /robots-v2)
ROBOTS_V2_ENABLED=true
# Resume live/paper sessions after API restart (metadata.sessionDesired=running)
ROBOTS_V2_AUTO_RESUME=true

# Vite origin (dev). Comma-separated or JSON list also work via pydantic.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

WS_PORT=8001
LIVE_EVENTS_BACKEND=postgres
WORKER_EMBEDDED_ENABLED=false

# GIN Compute (v2 backtest queue) — scale via: python -m app.workers.compute
# COMPUTE_MAX_USER_RUNNING=1
# COMPUTE_MAX_USER_QUEUED=10
# COMPUTE_MAX_SPAN_DAYS=366
# COMPUTE_BATCH_MAX_ITEMS=50
# LANE_HEAVY_CONCURRENCY=1

# OsEngine history for backtests (GIN pulls gaps via MCP OsData, then reads Data/)
# OSENGINE_ENABLED=true
# OSENGINE_DATA_ROOT=C:\Users\GY\osEngine\project\OsEngine\bin\Debug\Data
# OSENGINE_MCP_URL=http://localhost:6500/api/v1/mcp
# OSENGINE_MCP_API_KEY=osengine-mcp-default-key
# OSENGINE_MCP_SOURCE=TInvest
# OSENGINE_MCP_SOURCE_NAME=TInvest
# OSENGINE_MCP_SET_NAME=GinHistory
# OSENGINE_CANDLE_TZ=Europe/Moscow
# OSENGINE_AUTO_START=false
# OSENGINE_AUTO_START_ON_COMPUTE=true
# OSENGINE_EXE_PATH=C:\Users\GY\osEngine\project\OsEngine\bin\Debug\OsEngine.exe
# OSENGINE_STARTUP_TIMEOUT_SECONDS=90
# OSENGINE_STOP_ON_SHUTDOWN=true

