# Local development (optional: remote PostgreSQL)
# Copy to .env — do not commit secrets.

DB_HOST=your.remote.db.host
DB_PORT=5432
DB_NAME=gin
DB_USER=postgres
DB_PASSWORD=change_me
DB_SCHEMA=public
DB_SSL_MODE=require

SECRET_KEY=change_me_to_a_long_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

DEBUG=true
ENVIRONMENT=development

# Greenfield robots v2 (/api/v2/robots/*, UI /robots-v2)
ROBOTS_V2_ENABLED=true
# Resume live/paper sessions after API restart (metadata.sessionDesired=running)
ROBOTS_V2_AUTO_RESUME=true

# Vite origin (dev). Comma-separated or JSON list also work via pydantic.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

WS_PORT=8001
LIVE_EVENTS_BACKEND=postgres
WORKER_EMBEDDED_ENABLED=false
